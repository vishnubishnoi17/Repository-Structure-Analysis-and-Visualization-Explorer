# ── Repo Visualizer Backend — Environment Variables ───────────────────────────
# Copy this file to .env and fill in your values.

# GitHub Personal Access Token (optional — raises rate limit from 60 to 5000 req/hr)
# Get one at: github.com → Settings → Developer Settings → Personal Access Tokens
# Only needs: public_repo (read) scope
GITHUB_TOKEN=add_ur_github_token_here

# Google Gemini API Key
# Get yours FREE at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server settings (optional overrides)
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Scanner settings
CACHE_TTL_DAYS=7
MAX_SCAN_DEPTH=10
MAX_FILE_SIZE_KB=500
